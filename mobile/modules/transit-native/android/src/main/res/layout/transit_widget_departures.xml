<?xml version="1.0" encoding="utf-8"?>
<!-- Next departures from a saved stop - the Android version of the iOS
     Departures widget (targets/widgets/DeparturesWidget.swift). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/transit_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/transit_widget_bg"
  android:orientation="vertical"
  android:paddingStart="16dp"
  android:paddingEnd="8dp"
  android:paddingTop="12dp"
  android:paddingBottom="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/transit_widget_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/transit_widget_foreground"
      android:textSize="15sp"
      android:textStyle="bold" />
    <ImageView
      android:id="@+id/transit_widget_next"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:contentDescription="Next saved stop"
      android:padding="8dp"
      android:src="@drawable/transit_widget_next" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/transit_widget_rows"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:paddingEnd="8dp"
    android:orientation="vertical" />

  <TextView
    android:id="@+id/transit_widget_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="8dp"
    android:textColor="@color/transit_widget_muted"
    android:textSize="11sp" />
</LinearLayout>
